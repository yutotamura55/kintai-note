{
  "name": "kintai-note",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "db:apply": "wrangler d1 execute kintai-note --remote --file=db/schema.sql && wrangler d1 migrations apply kintai-note --remote",
    "db:local:seed": "wrangler d1 execute kintai-note --local --file=db/seed.local.sql",
    "db:local:cleanup": "wrangler d1 execute kintai-note --local --file=db/cleanup.local.sql",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "wrangler types server/cloudflare-env.d.ts --check && nuxt typecheck",
    "types:workers": "wrangler types server/cloudflare-env.d.ts",
    "test:local": "node scripts/test-local.mjs",
    "db:local:apply": "wrangler d1 execute kintai-note --local --file=db/schema.sql && wrangler d1 migrations apply kintai-note --local"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^13.1.1",
    "@simplewebauthn/server": "^14.0.2",
    "nuxt": "^3.17.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.19.1"
  }
}
