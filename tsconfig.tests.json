{
  // Tests import server and shared code, so they use the server settings and the Workers types.
  // scripts/*.mjs are read as on main, but checkJs is off, so their JavaScript is not type-checked.
  "extends": "./.nuxt/tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.nuxt/tsconfig.tests.tsbuildinfo"
  },
  "include": [
    "tests/**/*",
    "scripts/**/*",
    "eslint.config.mjs",
    ".nuxt/types/nitro-nuxt.d.ts",
    ".nuxt/types/nitro.d.ts",
    "server/worker-runtime.d.ts",
    "server/cloudflare-env.d.ts"
  ]
}
